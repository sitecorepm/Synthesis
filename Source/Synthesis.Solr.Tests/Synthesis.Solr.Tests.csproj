<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="App.config" />
    <None Remove="license.xml" />
    <None Remove="Synthesis.Solr.Tests.v3.ncrunchproject" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\App.config">
      <Link>App.config</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\license.xml">
      <Link>license.xml</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AutoFixture" Version="4.6.0" />
    <PackageReference Include="AutoFixture.AutoNSubstitute" Version="4.6.0" />
    <PackageReference Include="AutoFixture.Xunit2" Version="4.6.0" />
    <PackageReference Include="FluentAssertions" Version="5.5.3" />
    <PackageReference Include="NSubstitute" Version="4.2.1" />
    <PackageReference Include="Sitecore.ContentSearch" Version="10.5.0" />
    <PackageReference Include="Sitecore.ContentSearch.Linq" Version="10.5.0" />
    <PackageReference Include="Sitecore.ContentSearch.SolrProvider" Version="10.5.0" />
    <PackageReference Include="Sitecore.FakeDb" Version="3.0.0-alpha1" />
    <PackageReference Include="Sitecore.FakeDb.AutoFixture" Version="3.0.0-alpha1" />
    <PackageReference Include="Sitecore.FakeDb.NSubstitute" Version="3.0.0-alpha1" />
    <PackageReference Include="Sitecore.Kernel" Version="10.5.0" />
    <PackageReference Include="Sitecore.Logging" Version="10.5.0" />
    <PackageReference Include="Sitecore.Nexus" Version="10.1.3">
      <PrivateAssets></PrivateAssets>
    </PackageReference>
    <PackageReference Include="SolrNet.Core" Version="1.0.19" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.console" Version="2.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Synthesis.Solr\Synthesis.Solr.csproj" />
    <ProjectReference Include="..\Synthesis.Testing\Synthesis.Testing.csproj" />
    <ProjectReference Include="..\Synthesis.Tests\Synthesis.Tests.csproj" />
    <ProjectReference Include="..\Synthesis\Synthesis.csproj" />
  </ItemGroup>
</Project>
